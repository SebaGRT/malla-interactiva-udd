# Desarrollo local (el servidor del frontend redirige /api al backend)
# VITE_API_URL=/api

# Backend (local / Docker)
# PORT=3001
# DATABASE_PATH=data/malla.db
# DB_AUTO_SEED=true
# CURRICULUM_SOURCE=sqlite

# Vercel (set automatically in vercel.json — listed here for reference)
# VERCEL=1
# CURRICULUM_SOURCE=json
# DATA_DIR=./data
